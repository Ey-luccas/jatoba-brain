{
  "name": "jatoba-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memória persistente multi-projeto para agentes de IA via MCP, com PostgreSQL, pgvector, Git e Graphify.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && npm run build:dashboard",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "test": "node scripts/test.mjs",
    "test:release": "node scripts/release-check.mjs",
    "test:recovery": "node scripts/recovery-check.mjs",
    "test:security": "node scripts/security-check.mjs",
    "test:load": "node scripts/load-check.mjs",
    "test:observability": "node scripts/observability-check.mjs",
    "test:soak": "node scripts/soak-check.mjs",
    "test:stdio": "node scripts/stdio-check.mjs",
    "test:stdio:multi": "node scripts/stdio-multiprocess-check.mjs",
    "test:graph": "node scripts/graph-check.mjs",
    "eval:embeddings": "node scripts/eval-embeddings.mjs",
    "db:migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp:stdio": "node dist/stdio.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "playwright": "1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
