# Jatobá Brain
PORT=3338
HOST=0.0.0.0
NODE_ENV=production

# Em produção troque por uma chave longa e aleatória.
BRAIN_API_KEY=CHANGE_ME

# Hostnames/IPs aceitos no cabeçalho Host. Inclua o IP público da VPS.
ALLOWED_HOSTS=127.0.0.1,localhost,CHANGE_ME_VPS_IP

# PostgreSQL
POSTGRES_DB=jatoba
POSTGRES_USER=jatoba
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://jatoba:CHANGE_ME@postgres:5432/jatoba

# Workspace padrão para project.create quando nenhum workspace for informado.
DEFAULT_WORKSPACE=principal

# Embeddings opcionais. Se false, recall usa busca textual do PostgreSQL.
EMBEDDINGS_ENABLED=false
# Endpoint OpenAI-compatible /v1/embeddings (LM Studio, Ollama compatível, servidor local etc.)
EMBEDDINGS_API_URL=http://host.docker.internal:11434/v1/embeddings
EMBEDDINGS_API_KEY=CHANGE_ME
EMBEDDINGS_MODEL=nomic-embed-text

# Diretórios dentro do container
EXPORT_DIR=/app/exports
WORKSPACE_DIR=/workspace

# Grafos locais separados por projeto/repositorio; Graphify 0.9.55 no Docker.
GRAPH_DIR=/app/graphs
GRAPHIFY_BIN=graphify
