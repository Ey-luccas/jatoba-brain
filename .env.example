# Jatobá Brain
PORT=3338
HOST=0.0.0.0
BRAIN_BIND_ADDRESS=127.0.0.1
NODE_ENV=production

# Reverse proxy: 0 means do not trust forwarded client/protocol headers.
TRUST_PROXY_HOPS=0
HTTP_BODY_LIMIT=2mb
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
CORS_ORIGINS=
HSTS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_HEALTH_MAX=300
RATE_LIMIT_MCP_MAX=60

# Em produção troque por uma chave longa e aleatória.
BRAIN_API_KEY=CHANGE_ME

# Hostnames/IPs aceitos no cabeçalho Host. Inclua o IP público da VPS.
ALLOWED_HOSTS=127.0.0.1,localhost,CHANGE_ME_VPS_IP

# PostgreSQL
POSTGRES_DB=jatoba
POSTGRES_USER=jatoba
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://jatoba:CHANGE_ME@postgres:5432/jatoba

# Workspace padrão para project.create quando nenhum workspace for informado.
DEFAULT_WORKSPACE=principal

# Embeddings opcionais. Se false, recall usa busca textual do PostgreSQL.
EMBEDDINGS_ENABLED=false
# Provider compatível com a API OpenAI. Não é obrigatório e não envia dados quando desativado.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_VERSION=1
# Aliases legados ainda aceitos: EMBEDDINGS_API_URL, EMBEDDINGS_MODEL, EMBEDDINGS_DIMENSION.
EMBEDDINGS_API_URL=http://host.docker.internal:11434/v1/embeddings
EMBEDDINGS_API_KEY=CHANGE_ME
EMBEDDINGS_MODEL=nomic-embed-text

# Diretórios dentro do container
EXPORT_DIR=/app/exports
WORKSPACE_DIR=/workspace

# Grafos locais separados por projeto/repositorio; Graphify 0.9.55 no Docker.
GRAPH_DIR=/app/graphs
GRAPHIFY_BIN=graphify

# Tentativas limitadas de conexão durante startup/migrations.
DB_STARTUP_MAX_ATTEMPTS=10
DB_STARTUP_BACKOFF_MS=500
DB_STARTUP_MAX_BACKOFF_MS=5000
